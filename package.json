{
  "name": "vox-reader",
  "version": "2.6.5",
  "private": true,
  "type": "module",
  "description": "Chrome extension — read webpages aloud with word highlighting",
  "scripts": {
    "test": "bash tools/run-tests.sh",
    "test:e2e": "playwright test",
    "capture:store": "node tools/capture-store-assets.mjs",
    "check:store": "node tools/check-store-ready.mjs",
    "release:store": "node tools/release-store.mjs",
    "pack": "node tools/pack-extension.mjs",
    "pack:store": "npm run check:store && npm run fetch-deps && node tools/pack-extension.mjs --strict",
    "fetch-deps": "bash tools/fetch-deps.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
